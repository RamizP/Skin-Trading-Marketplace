# JWT signing key. Use a long random value in local/production environments.
SECRET_KEY=replace-with-a-long-random-secret

# Token lifetime in minutes.
TOKEN_LIVE_TIME=60

# Add demo accounts, catalog items, and orders on the first empty-database startup.
# Set to false to start with your own data only.
DEMO_DATA=true

# Optional. Defaults to src/v1/demo.db, with demo data on first startup.
# DATABASE_URL=postgresql+psycopg://user:password@localhost/trading_engine
